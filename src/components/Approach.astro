---
const steps = [
  {
    n: "01",
    title: "Assess",
    description:
      "We embed with your team to audit workloads, spend, and architecture — mapping the fastest path to a scalable, AI-ready foundation on AWS, GCP, or both.",
  },
  {
    n: "02",
    title: "Design",
    description:
      "A tailored architecture — compute, data, and AI/ML services — sized for the product you're building, not a generic template.",
  },
  {
    n: "03",
    title: "Build & ship",
    description:
      "Forward-deployed engineers working alongside yours, from proof of concept through production rollout, with minimal disruption.",
  },
  {
    n: "04",
    title: "Optimize",
    description:
      "Ongoing tuning for cost, performance, and model quality as usage grows — so the system gets smarter and cheaper together.",
  },
];
---

<section class="approach" id="approach">
  <div class="container">
    <div class="head">
      <span class="eyebrow">How We Work</span>
      <h2>A straightforward path from idea to production — on AWS, GCP, or both.</h2>
    </div>

    <div class="steps">
      {
        steps.map((step) => (
          <div class="step">
            <span class="n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .approach {
    padding: 5rem 0;
    background: var(--bg-soft);
  }

  .head {
    max-width: 640px;
    margin-bottom: 3rem;
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .step {
    position: relative;
    padding-top: 0.5rem;
  }

  .step::before {
    content: "";
    display: block;
    height: 3px;
    width: 2.5rem;
    background: var(--blue);
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .n {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    margin-bottom: 0.5rem;
  }

  h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .step p {
    color: var(--text-dim);
    font-size: 0.94rem;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2rem;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
