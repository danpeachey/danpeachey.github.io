---
import { Image } from "astro:assets";
import icon from "../assets/logo-wide.png";
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="copy">
      <span class="eyebrow">AWS &amp; Google Cloud Consulting</span>
      <h1>Cloud solutions built for Media, Entertainment, Gaming &amp; AI.</h1>
      <p class="lead">
        MEGA Cloud Consulting helps studios, platforms, and product builders design,
        migrate, and scale on AWS and Google Cloud — from render pipelines and
        streaming workloads to game backends and AI/ML infrastructure.
      </p>
      <div class="actions">
        <a href="#contact" class="btn btn-primary">Talk to a consultant</a>
        <a href="#focus" class="btn btn-secondary">Explore focus areas</a>
      </div>
    </div>

    <div class="art" aria-hidden="true">
      <div class="art-glow"></div>
      <Image src={icon} alt="" width={480} height={288} class="art-icon" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4.5rem 0 5rem;
    background: linear-gradient(180deg, var(--bg-soft) 0%, #ffffff 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 3rem;
  }

  h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin-bottom: 1.25rem;
  }

  .lead {
    display: block;
    font-size: 1.1rem;
    color: var(--text-dim);
    max-width: 42ch;
    margin-bottom: 2rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
  }

  .art-glow {
    position: absolute;
    inset: 8% 12%;
    background: radial-gradient(
      circle,
      rgba(79, 182, 218, 0.28) 0%,
      rgba(79, 182, 218, 0) 70%
    );
    filter: blur(4px);
  }

  .art :global(.art-icon) {
    position: relative;
    width: 100%;
    max-width: 420px;
    height: auto;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .lead {
      max-width: none;
      margin-left: auto;
      margin-right: auto;
    }
    .actions {
      justify-content: center;
    }
    .art {
      order: -1;
      min-height: 220px;
    }
    .art :global(.art-icon) {
      max-width: 260px;
    }
  }
</style>
